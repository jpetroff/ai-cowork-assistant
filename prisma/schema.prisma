// TypeScript-side peer schema definition.
// This file MUST stay in sync with the Rust migration in src-tauri/src/db.rs.
// When updating either file, update the other to match.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String @id
  name        String @unique
  folder_path String?
  created_at  Int
  updated_at  Int

  @@map("projects")
}

model Conversation {
  id         String  @id
  project_id String
  title      String?
  created_at Int
  updated_at Int

  @@map("conversations")
}

model Message {
  id              String @id
  conversation_id String
  role            String
  content         String
  sequence_order  Int
  created_at      Int

  @@map("messages")
}

model Artifact {
  id              String  @id
  conversation_id String
  message_id      String?
  title           String?
  content         String
  file_path       String?
  file_hash       String?
  version         Int
  created_at      Int
  updated_at      Int

  @@map("artifacts")
}

model LlmProvider {
  id            String  @id
  name          String
  provider_type String
  base_url      String
  api_key       String?
  is_default    Int
  created_at    Int

  @@map("llm_providers")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}
