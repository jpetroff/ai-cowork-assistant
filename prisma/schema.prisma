// TypeScript-side peer schema definition.
// This file MUST stay in sync with the Rust migration in src-tauri/src/db.rs.
// When updating either file, update the other to match.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id          String  @id
  name        String  @unique
  folder_path String?
  created_at  Int
  updated_at  Int

  @@map("projects")
}

model Conversation {
  id                 String  @id
  project_id         String
  title              String?
  // Cross-ref: points to artifacts.id — updated by artifactStore whenever the active artifact changes
  active_artifact_id String?
  created_at         Int
  updated_at         Int

  @@map("conversations")
}

model Message {
  id              String @id
  conversation_id String
  role            String
  content         String
  sequence_order  Int
  created_at      Int

  @@map("messages")
}

model Artifact {
  id                  String  @id
  conversation_id     String
  title               String?
  // Cross-ref: points to artifact_revisions.id — the HEAD (latest) revision
  current_revision_id String?
  file_path           String?
  file_hash           String?
  created_at          Int
  updated_at          Int

  @@map("artifacts")
}

model ArtifactRevision {
  id          String  @id
  artifact_id String
  // Cross-ref: points to messages.id — null while draft, set when sealed for send
  message_id  String?
  author      String
  content     String
  created_at  Int
  updated_at  Int

  @@map("artifact_revisions")
}

model LlmProvider {
  id            String  @id
  name          String
  provider_type String
  base_url      String
  api_key       String?
  is_default    Int
  created_at    Int

  @@map("llm_providers")
}

model AppSetting {
  key   String @id
  value String

  @@map("app_settings")
}
